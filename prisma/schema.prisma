// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Yacht {
  id                    Int      @id @default(autoincrement())
  builder               String?
  model                 String
  engines               String?
  engineHours           Int?     @map("engine_hours")
  length                Float
  beam                  Float?
  beamOpenPlatform      Float?   @map("beam_open_platform")
  draft                 Float?
  cruiseSpeed           Float?   @map("cruise_speed")
  maxSpeed              Float?   @map("max_speed")
  cabins                Int
  bathrooms             Int?
  maxGuests             Int?     @map("max_guests")
  maxSleeping           Int?     @map("max_sleeping")
  consumption           String?
  autonomy              String?
  fuelCapacity          Int?     @map("fuel_capacity")
  waterCapacity         Int?     @map("water_capacity")
  navigationClass       String?  @map("navigation_class")
  dryWeight             Float?   @map("dry_weight")
  hull                  String?
  status                String?
  available             Boolean
  rating                Float?
  reviewsCount          Int?     @map("reviews_count")
  city                  String?
  providerId            Int?     @map("provider_id")
  provider              Provider? @relation(fields: [providerId], references: [id])
  priceDay              Float?   @map("price_day")
  priceSale             Float?   @map("price_sale")
  year                  Int?
  region                String?
  currency              String
  lengthUnit            String   @map("length_unit")
  mapIframeSrc          String?  @map("map_iframe_src")
  priceHour             Float?   @map("price_hour")
  priceWeek             Float?   @map("price_week")
  // What Syrama actually pays the provider (B2B / wholesale cost), as
  // opposed to the price_day/week/hour/sale fields above which are what
  // gets charged to the client — lets the team see margin at a glance.
  b2bPrice              Float?   @map("b2b_price")
  // Some charters are only bookable in blocks of at least N hours (mainly
  // relevant alongside price_hour) — null means no minimum.
  minRentalHours        Int?     @map("min_rental_hours")
  createdAt             DateTime @default(now()) @map("created_at")
  media                 Media[]
  reservations          Reservation[]
  bookingLinks          BookingLink[]

  @@index([status])
  @@index([length])
  @@index([region])
  @@index([providerId])
  @@map("yacht")
}

model Media {
  id             Int       @id @default(autoincrement())
  propertyId     Int?      @map("property_id")
  yachtId        Int?      @map("yacht_id")
  url            String?
  alt            String?
  updatedAt      DateTime? @map("updated_at")
  luxuryWatchId  Int?      @map("luxury_watch_id")
  leadingYachtId Int?      @map("leading_yacht_id")
  yacht          Yacht?    @relation(fields: [yachtId], references: [id])

  @@index([yachtId])
  @@map("media")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user")
}

model Client {
  id        Int       @id @default(autoincrement())
  fullName  String    @map("full_name")
  // email/phone made optional to accommodate imported legacy leads that are
  // missing one or the other (or share a placeholder email) — still required
  // at the application layer when creating a client through a booking.
  email     String?   @unique
  phone     String?
  address   String?
  city      String?
  country   String?
  region    String?
  notes     String?
  // Which business line(s) this client has been a customer of — same value
  // space as Provider.type (e.g. "Yacht Charter"), and a real array like
  // Provider.services since a client can span more than one over time.
  services  String[]  @default([])
  // Free-text hashtags for richer context a single "service" can't capture —
  // e.g. "26 French Riviera Yacht Charter" to record year + region + service
  // in one glance. Deliberately unstructured (no separate year/region
  // columns) per the user's own "simplest is hashtags" framing.
  tags      String[]  @default([])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  reservations Reservation[]

  @@map("client")
}

model Reservation {
  id             Int       @id @default(autoincrement())
  clientId       Int       @map("client_id")
  // Optional — legacy bookings include non-yacht lines (transport, jet
  // charter) with no yacht at all, unlike the live charter-booking flow
  // which always supplies one.
  yachtId        Int?      @map("yacht_id")
  date           DateTime?
  // Legacy data records a stay as a start/end range rather than one date —
  // `date` is kept as the start (existing live flow still just sets this
  // one field), `endDate` added for the rest of that range when it exists.
  endDate        DateTime? @map("end_date")
  numberOfPeople Int?      @map("number_of_people")
  location       String?
  region         String?
  price          Float?
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Fields that only exist to preserve the legacy booking log's full
  // fidelity (it covers more than yacht charters: transport, jet_booking…)
  // — the live app never sets these, only the historical import does.
  type           String?
  objectId       Int?      @map("object_id")
  objectTitle    String?   @map("object_title")
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  email          String?
  phone          String?
  message        String?
  image          String?
  // Loose references, same convention as Yacht.providerId/Property.providerId
  // — no formal Prisma relation.
  providerId     Int?      @map("provider_id")
  propertyId     Int?      @map("property_id")
  priceTotal     Float?    @map("price_total")
  commissionRate Float?    @map("commission_rate")
  currency       String?

  // Embarkation/disembarkation time of day — kept separate from `date`/
  // `endDate` (which stay plain calendar days) so a reservation's time
  // can be edited on its own, same convention as BookingLink.
  startTime        String?   @map("start_time")
  endTime          String?   @map("end_time")
  plannedItinerary String?   @map("planned_itinerary")
  // Defaults match how a fresh reservation is set up in the admin: no
  // deposit yet, payment due immediately unless edited otherwise.
  deposit          Float?    @default(0)
  paymentDeadline  DateTime? @default(now()) @map("payment_deadline")

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  yacht     Yacht?    @relation(fields: [yachtId], references: [id], onDelete: SetNull)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  contract  Contract?

  @@index([clientId])
  @@index([yachtId])
  @@index([propertyId])
  @@index([region])
  @@map("reservation")
}

// The SYRAMA Private Yacht Experience Agreement, generated automatically
// once a client completes a booking link — a snapshot of what was known at
// that moment (client details, yacht, date/time), since the reservation or
// client records could change later while the issued contract must not.
model Contract {
  id                Int       @id @default(autoincrement())
  reservationId     Int       @unique @map("reservation_id")
  bookingReference  String    @unique @map("booking_reference")
  // "waiting_for_payment" until the team updates it by hand — this app
  // doesn't process payments itself.
  status            String    @default("waiting_for_payment")

  clientFullName    String    @map("client_full_name")
  clientEmail       String    @map("client_email")
  clientPhone       String    @map("client_phone")
  clientCountry     String?   @map("client_country")

  yachtModel        String    @map("yacht_model")
  yachtOperator     String?   @map("yacht_operator")

  experienceDate    DateTime  @map("experience_date")
  experienceEndDate DateTime? @map("experience_end_date")
  startTime         String?   @map("start_time")
  endTime           String?   @map("end_time")
  numberOfGuests    Int?      @map("number_of_guests")
  plannedItinerary  String?   @map("planned_itinerary")
  deposit           Float?
  paymentDeadline   DateTime? @map("payment_deadline")
  totalPrice        Float?    @map("total_price")
  // Snapshot of Reservation.createdAt — the SYRAMA signature date shows
  // when the booking itself was made, not when the contract PDF happens
  // to be (re)generated.
  reservationCreatedAt DateTime? @map("reservation_created_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("contract")
}

// Imported from the legacy booking system's own `invoice` table (client
// service invoices and provider commission invoices alike), and now also
// created going forward from a reservation that already has a contract.
// `reservationId`/`providerId`/`customerId` are loose references, same
// convention as elsewhere in this schema — several imported rows point to
// legacy reservations that were never carried over, so a formal relation
// (and the FK constraint it implies) would break the import.
model Invoice {
  id               Int       @id @default(autoincrement())
  reservationId    Int?      @map("reservation_id")
  providerId       Int?      @map("provider_id")
  customerId       Int?      @map("customer_id")
  // "INV-26<id>" — continues the legacy numbering scheme (year prefix +
  // the row's own auto-increment id), so a freshly created invoice's
  // number is always the next one in the same sequence.
  invoiceNumber    String    @unique @map("invoice_number")
  type             String
  serviceTitle     String?   @map("service_title")
  serviceCity      String?   @map("service_city")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  priceTotal       Float?    @map("price_total")
  commissionRate   Float?    @map("commission_rate")
  commissionAmount Float?    @map("commission_amount")
  currency         String
  status           String    @default("draft")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  // "service" (billed to the client) or "commission" (billed to/deducted
  // from a provider) — only "service" is created from the live app today.
  category         String
  applyVat         Boolean   @default(false) @map("apply_vat")
  vatRate          Float     @default(0) @map("vat_rate")

  @@index([reservationId])
  @@map("invoice")
}

// A shareable link the admin generates for one specific yacht + date/time
// slot (e.g. from a WhatsApp conversation) — the client opens it, fills in
// their contact details, and that creates the reservation directly instead
// of the team relaying the details back and forth manually.
model BookingLink {
  id            Int       @id @default(autoincrement())
  token         String    @unique
  yachtId       Int       @map("yacht_id")
  date          DateTime
  // Only set for a multi-day charter — null means the same day as `date`.
  endDate       DateTime? @map("end_date")
  startTime     String    @map("start_time")
  endTime       String?   @map("end_time")
  // "pending" until the client submits the form, then "completed" — a
  // completed link shows a "already booked" message instead of the form
  // again, so re-opening it (e.g. from chat history) can't double-book.
  status        String    @default("pending")
  reservationId Int?      @map("reservation_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  yacht         Yacht     @relation(fields: [yachtId], references: [id], onDelete: Cascade)

  @@index([yachtId])
  @@map("booking_link")
}

model Provider {
  id           Int       @id @default(autoincrement())
  name         String?
  company      String?
  email        String?
  phone        String?
  city         String?
  country      String?
  type         String?
  services     String[]  @default([])
  description  String?
  isActive     Boolean?  @map("is_active")
  website      String?
  instagram    String?
  // A link the team can come back to while working with this provider —
  // usually their yacht/product catalog, often shared as a Google Drive
  // folder rather than a proper website.
  catalogUrl   String?   @map("catalog_url")
  notes        String?
  position     String?
  firstContact String?   @map("first_contact")
  firstName    String?   @map("first_name")
  region       String?
  updatedAt    DateTime? @map("updated_at")
  manager      String?
  address      String?
  postalCode   String?   @map("postal_code")
  yachts       Yacht[]

  @@index([type])
  @@index([region])
  @@index([city])
  @@index([country])
  @@index([services], type: Gin)
  @@map("provider")
}

model Property {
  id              Int      @id @default(autoincrement())
  title           String?
  description     String?
  city            String?
  zipCode         String?  @map("zip_code")
  type            String?
  surface         Float?
  rooms           Int?
  bedrooms        Int?
  bathrooms       Int?
  price           Float?
  reference       String?
  year            Int?
  forSale         Boolean? @map("for_sale")
  isOffMarket     Boolean? @map("is_off_market")
  region          String?
  available       Boolean?
  status          String?
  rating          Float?
  reviewsCount    Int?     @map("reviews_count")
  surfaceUnit     String?  @map("surface_unit")
  currency        String?
  mapIframeSrc    String?  @map("map_iframe_src")
  // Loose reference, same convention as Yacht.providerId — no formal
  // Prisma @relation to keep this table independent of the Provider model.
  providerId      Int?     @map("provider_id")
  priceDay        Float?   @map("price_day")
  maxGuests       Int?     @map("max_guests")
  beds            Int?
  terraceSurface  Float?   @map("terrace_surface")
  hasTerrace      Boolean? @map("has_terrace")
  hasBalcony      Boolean? @map("has_balcony")
  petsAllowed     Boolean? @map("pets_allowed")
  partiesAllowed  Boolean? @map("parties_allowed")
  checkInFrom     String?  @map("check_in_from")
  checkOutBefore  String?  @map("check_out_before")
  amenities       Json?
  bedDistribution Json?    @map("bed_distribution")
  priceWeek       Float?   @map("price_week")
  priceMonth      Float?   @map("price_month")
  reservations    Reservation[]

  @@map("property")
}

model Message {
  id              Int      @id @default(autoincrement())
  name            String?
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  email           String
  phone           String?
  subject         String
  message         String
  destination     String?
  preferredDate   String?  @map("preferred_date")
  numberOfGuests  Int?     @map("number_of_guests")
  status          String   @default("unread")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([status])
  @@map("message")
}